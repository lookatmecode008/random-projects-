:root {
  color-scheme: light;
  --ink: rgb(232, 60, 84);
  --ink-soft: #405564;
  --muted: #020507;
  --page: #f3f6f7;
  --surface: #ffffff;
  --line: #dce5e9;
  --navy: rgb(35, 138, 32);
  --navy-hover: #243e50;
  --teal: #087f75;
  --teal-pale: #e8f6f3;
  --blue-pale: #edf4f8;
  --amber-pale: #fff6e6;
  --amber-ink: #8a5a10;
  --radius-lg: 20px;
  --radius-md: 13px;
  --shadow: 0 8px 28px rgba(23, 43, 58, 0.055);
  font-family:
    system-ui,
    -apple-system,
    BlinkMacSystemFont,
    "Segoe UI",
    sans-serif;
  font-synthesis: none;
  text-rendering: optimizeLegibility;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
}

* {
  box-sizing: border-box;
}

html {
  min-width: 320px;
  background: var(--page);
}

body {
  margin: 0;
  color: var(--ink);
  background: var(--page);
  font-size: 16px;
  line-height: 1.5;
}

button,
input {
  font: inherit;
}

button {
  -webkit-tap-highlight-color: transparent;
}

.app-shell {
  width: 100%;
  min-height: 100vh;
  min-height: 100dvh;
  display: flex;
  flex-direction: column;
}

.topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  padding: 15px 18px;
  color: #fff;
  background: var(--navy);
}

.brand {
  display: flex;
  align-items: center;
  gap: 10px;
  min-width: 0;
}

.brand-mark {
  display: grid;
  width: 50px;
  height: 50px;
  flex: 0 0 auto;
  place-items: center;

  color: #fff;
  font-size: 1.15rem;
  font-weight: 800;
}

.brand-mark img {
  width: 100%;
  height: auto;
  border-radius: 0.25rem;
}

.brand-copy {
  display: flex;
  flex-direction: column;
  line-height: 1.2;
}

.brand-name {
  font-size: 0.82rem;
  font-weight: 800;
  letter-spacing: 0.12em;
}

.brand-subtitle {
  margin-top: 4px;
  color: #c4d2da;
  font-size: 0.65rem;
  letter-spacing: 0.13em;
}

.connection-status {
  display: inline-flex;
  align-items: center;
  gap: 7px;
  flex: 0 0 auto;
  padding: 7px 9px;
  border: 1px solid rgba(255, 255, 255, 0.18);
  border-radius: 999px;
  color: #e4f5ef;
  font-size: 0.72rem;
  white-space: nowrap;
}

.status-dot {
  width: 7px;
  height: 7px;
  border-radius: 50%;
  background: #72d5a7;
  box-shadow: 0 0 0 3px rgba(114, 213, 167, 0.12);
}

.main-content {
  width: 100%;
  max-width: 680px;
  margin: 0 auto;
  padding: 27px 16px 32px;
  flex: 1;
}

.welcome-section {
  margin: 0 2px 23px;
}

.eyebrow,
.step-label {
  margin: 0 0 7px;
  color: var(--teal);
  font-size: 0.7rem;
  font-weight: 800;
  letter-spacing: 0.14em;
}

h1,
h2,
p {
  margin-top: 0;
}

h1 {
  max-width: 520px;
  margin-bottom: 9px;
  font-size: clamp(1.9rem, 8vw, 2.55rem);
  line-height: 1.08;
  letter-spacing: -0.045em;
}

.intro {
  max-width: 470px;
  margin-bottom: 0;
  color: var(--muted);
  font-size: 0.96rem;
}

.panel {
  margin-bottom: 16px;
  padding: 20px 17px;
  border: 1px solid var(--line);
  border-radius: var(--radius-lg);
  background: var(--surface);
  box-shadow: var(--shadow);
}

.panel-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  margin-bottom: 19px;
}

.panel-heading h2 {
  margin: 0;
  font-size: 1.14rem;
  line-height: 1.25;
  letter-spacing: -0.02em;
}

.step-label {
  margin-bottom: 5px;
  font-size: 0.63rem;
}

.step-number {
  display: grid;
  width: 37px;
  height: 37px;
  flex: 0 0 auto;
  place-items: center;
  border-radius: 12px;
  color: #355365;
  background: var(--blue-pale);
  font-size: 0.78rem;
  font-weight: 800;
}

.employee-form label {
  display: block;
  margin-bottom: 8px;
  font-size: 0.87rem;
  font-weight: 750;
}

.input-row {
  display: flex;
  flex-direction: column;
  gap: 9px;
}

input[type="text"] {
  width: 100%;
  min-width: 0;
  min-height: 52px;
  padding: 13px 14px;
  border: 1px solid #cbd8de;
  border-radius: var(--radius-md);
  outline: none;
  color: var(--ink);
  background: #fff;
  font-size: 1rem;
  transition:
    border-color 140ms ease,
    box-shadow 140ms ease;
}

input[type="text"]::placeholder {
  color: #96a5ad;
}

input[type="text"]:focus-visible {
  border-color: var(--teal);
  box-shadow: 0 0 0 4px rgba(8, 127, 117, 0.13);
}

.button {
  display: inline-flex;
  min-height: 49px;
  align-items: center;
  justify-content: center;
  gap: 9px;
  padding: 12px 16px;
  border: 1px solid transparent;
  border-radius: var(--radius-md);
  font-weight: 750;
  text-align: center;
  cursor: pointer;
  transition:
    background-color 140ms ease,
    transform 140ms ease,
    border-color 140ms ease;
}

.button:active:not(:disabled) {
  transform: translateY(1px);
}

.button:focus-visible {
  outline: 3px solid rgba(8, 127, 117, 0.32);
  outline-offset: 2px;
}

.button-primary {
  color: #fff;
  background: var(--navy);
}

.button-primary:hover {
  background: var(--navy-hover);
}

.field-help {
  margin: 8px 0 0;
  color: var(--muted);
  font-size: 0.78rem;
}

.identity-preview {
  display: flex;
  align-items: center;
  gap: 11px;
  margin-top: 19px;
  padding: 13px 12px;
  border: 1px dashed #cbd8de;
  border-radius: 15px;
  background: #f9fbfc;
}

.avatar-placeholder {
  display: grid;
  width: 43px;
  height: 43px;
  flex: 0 0 auto;
  place-items: center;
  border-radius: 13px;
  color: #607887;
  background: #e8eef2;
}

.avatar-placeholder svg {
  width: 24px;
  height: 24px;
}

.identity-copy {
  min-width: 0;
  flex: 1;
}

.identity-name {
  margin: 0 0 3px;
  color: #435866;
  font-size: 0.83rem;
  font-weight: 750;
}

.identity-message {
  margin: 0;
  color: var(--muted);
  font-size: 0.74rem;
  line-height: 1.4;
}

.identity-state {
  align-self: flex-start;
  flex: 0 0 auto;
  padding: 5px 7px;
  border-radius: 7px;
  color: var(--amber-ink);
  background: var(--amber-pale);
  font-size: 0.65rem;
  font-weight: 750;
}

.attendance-state {
  display: flex;
  align-items: flex-start;
  gap: 12px;
  padding: 14px;
  border-radius: 15px;
  background: #f4f7f8;
}

.state-icon {
  display: grid;
  width: 39px;
  height: 39px;
  flex: 0 0 auto;
  place-items: center;
  border-radius: 12px;
  color: #3b6576;
  background: #e3edf1;
}

.state-icon svg {
  width: 23px;
  height: 23px;
}

.state-title {
  margin: 1px 0 4px;
  font-size: 0.86rem;
  font-weight: 800;
}

.state-description {
  margin: 0;
  color: var(--muted);
  font-size: 0.78rem;
  line-height: 1.45;
}

.action-buttons {
  display: grid;
  grid-template-columns: 1fr;
  grid-template-rows: 1fr 1fr;
  gap: 10px;
  margin-top: 14px;
}

.action-buttons .button svg {
  width: 21px;
  height: 21px;
}

#primaryActionButtons {
  width: 100%;
}

.button-clock-in {
  color: #fff;
  background: var(--teal);
}

.button-clock-out {
  color: var(--ink);
  border-color: var(--line);
  background: #fff;
}

.button:disabled {
  color: #87959c;
  border-color: #e1e7ea;
  background: #edf1f3;
  cursor: not-allowed;
}

.disabled-note {
  margin: 10px 0 0;
  color: #7b8a92;
  font-size: 0.72rem;
  text-align: center;
}

#

.privacy-note {
  display: flex;
  align-items: flex-start;
  gap: 11px;
  padding: 15px 14px;
  border: 1px solid #d5e8e3;
  border-radius: 15px;
  color: #36564f;
  background: var(--teal-pale);
}

.privacy-note svg {
  width: 22px;
  height: 22px;
  flex: 0 0 auto;
  margin-top: 1px;
}

.privacy-note p {
  margin: 0;
  font-size: 0.79rem;
  line-height: 1.5;
}

.privacy-note strong {
  font-weight: 800;
}

.app-footer {
  display: flex;
  justify-content: space-between;
  gap: 12px;
  padding: 16px 18px 20px;
  color: #81909a;
  font-size: 0.7rem;
}

/* ATTENDANCE REGISTER STYLING */

td {
  min-width: 100px;
}

/* Wider screens get more breathing room; the mobile layout is the default. */
@media (min-width: 520px) {
  .topbar {
    padding: 17px 25px;
  }

  .main-content {
    padding: 38px 24px 40px;
  }

  .welcome-section {
    margin-bottom: 27px;
  }

  .panel {
    padding: 24px;
  }

  .input-row {
    flex-direction: row;
  }

  .input-row input {
    flex: 1;
  }

  .input-row .button {
    min-width: 135px;
  }

  .action-buttons {
    grid-template-columns: 1fr 1fr;
  }

  .app-footer {
    padding-right: 25px;
    padding-left: 25px;
  }
}

@media (prefers-reduced-motion: reduce) {
  *,
  *::before,
  *::after {
    scroll-behavior: auto !important;
    transition-duration: 0.01ms !important;
    animation-duration: 0.01ms !important;
    animation-iteration-count: 1 !important;
  }
}
